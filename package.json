{
  "name": "elotempo",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "description": "Elotempo — Software desktop offline para árvores genealógicas e contexto de vidas, compatível com GEDCOM 7.0",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "verificar": "npm run typecheck && npm run test && npm run test:rust",
    "abrir": "npm run build && cargo build --manifest-path src-tauri/Cargo.toml --features custom-protocol && \"src-tauri/target/debug/elotempo\"",
    "instalador": "tauri build",
    "instalador:nsis": "tauri build -b nsis",
    "instalador:msi": "tauri build -b msi",
    "seed:ibge": "node scripts/gerar-seed-ibge.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.436.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
