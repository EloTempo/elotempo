# Dependências
node_modules/

# Build do frontend
dist/
dist-ssr/
*.local

# Build do Rust / Tauri (chega a alguns GB)
src-tauri/target/

# Dados do usuário — NUNCA versionar.
# O acervo é o arquivo pessoal de quem usa o programa.
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# Mídia e documentos anexados pelo usuário
/dados/
/midia/

# Instaladores e toolchains baixados localmente
rustup-init.exe
*.msi
*.exe.download

# Editor / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Zips de design (duplicam os PNGs já extraídos ao lado, em Design/)
Design/*.zip
**/.thumbnail

# Logs
*.log
npm-debug.log*

# Configuração local de ferramentas de agente
.claude/

# Caches e arquivos temporários de desenvolvimento
scratch/
sora_test.ttf
*.zip
*.part
__pycache__/
*.pyc
_imagens_elotempo/

# Repositório separado do site
elotempo-site/

# Configuracao local do cargo: aponta para a instalacao de OpenSSL desta
# maquina (o SQLCipher precisa dela para compilar no Windows). O caminho e
# especifico de quem compila -- versionar quebraria a build de todo mundo,
# inclusive a do Linux no CI. O requisito esta documentado em DISTRIBUICAO.md.
src-tauri/.cargo/config.toml
